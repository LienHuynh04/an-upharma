  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.Token) pm.collectionVariables.set('token', json.Token);",
                  "if (json.UserInfo && json.UserInfo.uPharmaID) pm.collectionVariables.set('uPharmaID', String(json.UserInfo.uPharmaID));",
                  "if (json.UserInfo && Array.isArray(json.UserInfo.ShopLst) && json.UserInfo.ShopLst.length > 0) {",
                  "  const firstAllowedShop = json.UserInfo.ShopLst.find(shop => shop.ShopCode !== 'SHOP0040') || json.UserInfo.ShopLst[0];",
                  "  pm.collectionVariables.set('shopCode', firstAllowedShop.ShopCode);",
                  "}",
                  "pm.test('Login OK', function () {",
                  "  pm.expect(json.RespCode).to.eql(0);",
                  "  pm.expect(json.Token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserName\": \"{{username}}\",\n  \"Password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/User/UserLogin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "User",
                "UserLogin"
              ]
            }
          }
        },
        {
          "name": "Get User Info By ID",
          "request": {
