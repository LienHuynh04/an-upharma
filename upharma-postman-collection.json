              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Token\": \"{{token}}\",\n  \"uPharmaID\": \"{{uPharmaID}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/User/GetUserInfoByID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "User",
