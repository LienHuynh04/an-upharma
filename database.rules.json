{
  "rules": {
    ".read": "false",
    ".write": "false",
    "product_catalog": {
      ".read": "true",
      ".write": "auth != null"
    },
    "national_inventory_cache": {
      ".read": "true",
      ".write": "auth != null"
    },
    "transfer_suggestions_cache": {
      ".read": "true",
      ".write": "true"
    },
    "users_by_username": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hidden_products": {
      ".read": "true",
      ".write": "true"
    },
    "shops_summary": {
      ".read": "true",
      ".write": "auth != null"
    },
    "shops": {
      "$shopCode": {
        "upharma_data": {
          ".read": "true",
          ".write": "auth != null"
        }
      }
    },
    "system_admin": {
      ".read": "auth != null",
      ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid"
    },
    "staff_users": {
      ".read": "auth != null && (root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid)",
      ".write": "auth != null && (root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid)",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "shop_catalog_index": {
      ".read": "auth != null",
      ".write": false
    },
    "shop_catalog": {
      "$shopCode": {
        ".read": "auth != null && ((root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid) || (root.child('staff_users').child(auth.uid).child('active').val() == true && root.child('staff_users').child(auth.uid).child('shops').child($shopCode).val() == true))",
        ".write": false
      }
    },
    "count_submissions": {
      "$shopCode": {
        ".read": "auth != null && (root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid)",
        "$sessionId": {
          ".write": "auth != null && ((root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid) || (root.child('staff_users').child(auth.uid).child('active').val() == true && (newData.child('staffUid').val() == auth.uid || data.child('staffUid').val() == auth.uid)))"
        }
      }
    },
    "count_final_reviews": {
      "$shopCode": {
        ".read": "auth != null && (root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid)",
        ".write": "auth != null && (root.child('staff_users').child(auth.uid).child('role').val() == 'admin' || root.child('system_admin').child('uid').val() == auth.uid)"
      }
    }
  }
}
