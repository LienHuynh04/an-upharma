# Các biến môi trường cần cấu hình trên Github Actions (git env)
# để script đồng bộ chạy được với Firebase Realtime Database

# (Bắt buộc) Toàn bộ nội dung chuỗi JSON của Service Account (tải từ Firebase Console)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# (Không bắt buộc nhưng khuyên dùng) Link Realtime Database của bạn
FIREBASE_DATABASE_URL='https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app'

# Các biến đã có sẵn từ trước:
# UPHARMA_USERNAME='...'
# UPHARMA_PASSWORD='...'
# UPHARMA_EXCLUDED_SHOPS='SHOP0040'
